@unpublished{dziedzic2026nonlinearlatent,
  title        = {Nonlinear Latent Decoding for Inverse Scattering},
  author       = {Anonymous},
  year         = {2026},
  note         = {Under blind review},
  abbr         = {Under Review},
  abstract     = {Inverse scattering problems represent a severely ill-posed regime where the spatially varying contrast of a medium is recovered from measurements of the scattered wavefield. Typically, machine-learning approaches output reconstructions in a spatial parametrization, where the medium is discretized with neural networks predicting the contrast at each grid point. In this paper, we propose methods for nonlinear latent decoding, replacing direct spatial prediction with reconstruction through a learned, lower-dimensional nonlinear parametrization. Across three target distributions, three noise levels, and multiple seeds, pretrained latent decoding reduces normalized mean squared reconstruction error (NMSE) by an average of 34\% relative to the spatial-output variants of five leading neural-operator architectures. On geometric targets our jointly trained nonlinear latent synthesis head, matched to the spatial head within 0.1\% in parameters and 0.3\% in MACCs, shows 45\% and 57\% reduction of NMSE at 200 and 3200 training pairs, respectively. Parameter sweeps show that under a matched training schedule the spatial head does not reach our nonlinear latent head's NMSE until surpassing 7× the trainable parameters. We show that our nonlinear latent parametrization improves reconstruction accuracy at matched or reduced capacity.},
  website      = {/publications/nonlinear-latent-decoding/},
  preview      = {nonlinear-latent-decoding.png},
  bibtex_show  = {true},
  selected     = {false}
}
