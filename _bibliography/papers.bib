@unpublished{dziedzic2026nonlinearlatent,
  title        = {Nonlinear Latent Decoding for Inverse Scattering},
  author       = {Anonymous},
  year         = {2026},
  note         = {Under blind review},
  abbr         = {Under Review},
  abstract     = {Learned inverse-scattering solvers typically predict a discretized medium contrast directly on a spatial grid. We instead parameterize the output through a low-dimensional nonlinear chart: a neural operator predicts latent coordinates, and a decoder maps them to the reconstructed contrast. This intervention leaves the measurement-processing backbone unchanged and supports either pretrained, frozen decoders or decoders learned jointly from the image loss. Across five backbones---Transolver, Galerkin Transformer, OFormer, GNOT, and FFNO---three target distributions, and three noise levels, the frozen-decoder implementation lowers normalized mean squared error in 44 of 45 configurations, averaging a 34.4\% reduction relative to the corresponding direct-reconstruction baselines. The result persists when measurements are generated from raw scatterers on a finer forward-solver grid. In a stricter capacity-controlled study on geometric targets, a randomly initialized 256-coordinate synthesis head, matched to a spatial head within 0.05\% in parameters and 0.29\% in multiply--accumulates, reduces error by 45\% with 200 training pairs and 57\% with 3,200, winning all ten paired seeds at both sizes. Matched-dimension, interface, and width controls show that linear compression, decoder architecture alone, and added parameter count do not explain the effect. An approximation-error analysis characterizes the obstruction imposed by fixed affine reconstruction spaces. Replications on handwritten digits and smooth random fields find the largest gains in the scarce-data regime, while organ, measured-data, and 3D Born experiments delineate the method's limits. These results identify nonlinear output parameterization as a reusable design choice for learned inverse scattering.},
  website      = {/publications/nonlinear-latent-decoding/},
  preview      = {nonlinear-latent-decoding.png},
  bibtex_show  = {true},
  selected     = {false}
}
