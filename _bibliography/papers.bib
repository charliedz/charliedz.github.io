@unpublished{dziedzic2026nonlinearlatent,
  title        = {Nonlinear Latent Decoding for Inverse Scattering},
  author       = {Anonymous},
  year         = {2026},
  note         = {Under blind review},
  abbr         = {Under Review},
  abstract     = {Inverse scattering recovers the spatially varying contrast of a medium from measurements of its scattered wavefield. Most learned methods predict that contrast directly on a spatial grid. We instead have the inverse network predict coordinates that a nonlinear decoder maps to the reconstruction. Across five neural-operator backbones, three synthetic target distributions, three noise levels, and multiple seeds, a pretrained frozen decoder lowers normalized mean squared error by 34.4\% on average and improves 44 of 45 configurations. A scratch nonlinear synthesis head whose parameter count differs from the spatial head by 0.02\% and whose compute differs by 0.07\% lowers error by 46.2\% with 200 Shapes pairs and 64.1\% with 3,200, winning all ten paired seeds at each data size. On the full official OrganAMNIST split, scratch and pretrained nonlinear heads lower error by 35.3\% and 53.0\%, respectively. With 12,800 paired Shapes examples, a capacity- and compute-matched pretrained head still improves all five backbones. Together, the experiments show that nonlinear coordinate prediction can be an effective reconstruction interface across the tested operator architectures under simulated scattering.},
  website      = {/publications/nonlinear-latent-decoding/},
  preview      = {nonlinear-latent-decoding.png},
  bibtex_show  = {true},
  selected     = {false}
}
